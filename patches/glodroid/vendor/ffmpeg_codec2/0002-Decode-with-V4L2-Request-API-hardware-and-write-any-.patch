     addParameter(
diff --git a/ffmpeg_utils/ffmpeg_hwaccel.c b/ffmpeg_utils/ffmpeg_hwaccel.c
index 531a454..baea852 100644
--- a/ffmpeg_utils/ffmpeg_hwaccel.c
+++ b/ffmpeg_utils/ffmpeg_hwaccel.c
@@ -7,7 +7,20 @@
 #include "libavutil/opt.h"
 
 int ffmpeg_hwaccel_init(AVCodecContext *avctx) {
-    if (avctx->codec_id != AV_CODEC_ID_HEVC || !property_get_bool("persist.vendor.ffmpeg_codec2.v4l2.h265", 0))
+    switch (avctx->codec_id) {
+        case AV_CODEC_ID_AV1:
+        case AV_CODEC_ID_H264:
+        case AV_CODEC_ID_HEVC:
+        case AV_CODEC_ID_MPEG2VIDEO:
+        case AV_CODEC_ID_VP8:
+        case AV_CODEC_ID_VP9:
+            break;
+        default:
+            return 0;
+    }
+    // Hardware decoding (V4L2 Request API) unless disabled; FFmpeg falls back to software
+    // decoding for streams the hardware can't handle.
+    if (!property_get_bool("persist.vendor.ffmpeg_codec2.hwaccel", 1))
         return 0;
 
     // Find codec information. At this point, AVCodecContext.codec may not be
@@ -55,46 +68,8 @@ int ffmpeg_hwaccel_init(AVCodecContext *avctx) {
 void ffmpeg_hwaccel_deinit(AVCodecContext *avctx __unused) {
 }
 
-int ffmpeg_hwaccel_get_frame(AVCodecContext *avctx, AVFrame *frame) {
-    if (!frame->hw_frames_ctx) {
-        // Frame is not hw-accel
-        return 0;
-    }
-
-    AVFrame* output;
-    int err;
-
-    output = av_frame_alloc();
-    if (!output) {
-        return AVERROR(ENOMEM);
-    }
-
-    output->format = AV_PIX_FMT_YUV420P;
-    if (avctx->profile == AV_PROFILE_HEVC_MAIN_10) {
-        output->format = AV_PIX_FMT_NV12;
-    }
-
-    err = av_hwframe_transfer_data(output, frame, 0);
-    if (err < 0) {
-        ALOGE("ffmpeg_hwaccel_get_frame failed to transfer data: %s (%08x)",
-              av_err2str(err), err);
-        goto fail;
-    }
-
-    err = av_frame_copy_props(output, frame);
-    if (err < 0) {
-        ALOGE("ffmpeg_hwaccel_get_frame failed to copy frame properties: %s (%08x)",
-              av_err2str(err), err);
-        goto fail;
-    }
-
-    av_frame_unref(frame);
-    av_frame_move_ref(frame, output);
-    av_frame_free(&output);
-
+int ffmpeg_hwaccel_get_frame(AVCodecContext *avctx __unused, AVFrame *frame __unused) {
+    // Hardware frames are kept as they are: the component maps them when it copies
+    // the picture into the output buffer, which saves an intermediate copy.
     return 0;
-
-fail:
-    av_frame_free(&output);
-    return err;
 }
