From fab3efff7fa34b4b2b3b3ea02a3073551d10481d Mon Sep 17 00:00:00 2001
From: tad <tad.keller@pm.me>
Date: Tue, 3 Nov 2026 17:00:29 -0600
Subject: [PATCH] meson: build Codec2 headers with Soong's
 -Wno-invalid-specialization

C2Enum.h specializes std::underlying_type and std::is_enum, which clang
rejects by default; Soong turns that off for every module.
---
 meson.build | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index f0a8d89..b5ad069 100644
--- a/meson.build
+++ b/meson.build
@@ -26,7 +26,9 @@ executable(
         'ffmpeg_utils/ffmpeg_utils.cpp',
     ),
     c_args : ['-DFFMPEG_CODEC2_VENDOR_INSTALL'],
-    cpp_args : ['-DFFMPEG_CODEC2_VENDOR_INSTALL', '-Wno-inconsistent-missing-override'],
+    # -Wno-invalid-specialization: Soong's global flag, which Codec2's C2Enum.h needs
+    cpp_args : ['-DFFMPEG_CODEC2_VENDOR_INSTALL', '-Wno-inconsistent-missing-override',
+                '-Wno-invalid-specialization'],
     include_directories : include_directories('.', 'ffmpeg_utils'),
     install : true,
     install_dir : get_option('bindir') / 'hw',
-- 
2.55.0

