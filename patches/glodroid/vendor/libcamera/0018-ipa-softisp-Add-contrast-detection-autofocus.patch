@@ -0,0 +1,376 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+#include "libcamera/internal/value_node.h"
+
+/**
+ * \file af.h
+ */
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+/**
+ * \class Af
+ * \brief Contrast detection autofocus
+ *
+ * The algorithm drives a voice coil motor lens through V4L2_CID_FOCUS_ABSOLUTE
+ * and measures the sharpness of the centre of the image with the focus
+ * measure of the software ISP statistics (SwIspStats::afSharpness), normalised
+ * by the square of the mean green level so that it doesn't follow exposure
+ * changes.
+ *
+ * A scan steps the lens from the infinity end of its range towards macro,
+ * stops once the contrast has clearly dropped past a peak, and moves the lens
+ * to the peak, interpolated by a parabola through the best position and its
+ * neighbours. A scan that sees no clear peak fails and leaves the lens at the
+ * sharpest position found.
+ *
+ * - AfModeManual: the lens follows the LensPosition control.
+ * - AfModeAuto: AfTriggerStart runs one scan, AfTriggerCancel stops it.
+ * - AfModeContinuous: scans when started, then rescans when the contrast
+ *   changes by more than a threshold and the scene is steady again. AfPause
+ *   suspends it, at once or after the current scan.
+ *
+ * Tuning parameters, all optional, as lens driver codes unless noted:
+ * - range: [min, max] codes to scan, the lens control range by default
+ * - infinity, macro: codes that focus at infinity and at maxDioptres, for
+ *   the LensPosition control and metadata; the range ends by default
+ * - maxDioptres: the closest focus distance, in dioptres (default 10)
+ * - step: scan step (default 1/16 of the range)
+ * - default: lens position before AF runs (default: infinity)
+ * - settleFrames: frames to wait after a lens move (default 3)
+ * - rescanThreshold: relative contrast change that triggers a rescan in
+ *   continuous mode (default 0.3)
+ * - minPeakRatio: ratio of best to lowest contrast below which a scan
+ *   fails (default 1.1)
+ */
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	auto it = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == context.lensControls.end()) {
+		LOG(IPASoftAf, Info) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	const ControlInfo &lensInfo = it->second;
+	int32_t lensMin = lensInfo.min().get<int32_t>();
+	int32_t lensMax = lensInfo.max().get<int32_t>();
+
+	std::vector<int32_t> range =
+		tuningData["range"].get<std::vector<int32_t>>().value_or(std::vector<int32_t>{});
+	if (range.size() == 2) {
+		rangeMin_ = std::clamp(range[0], lensMin, lensMax);
+		rangeMax_ = std::clamp(range[1], rangeMin_, lensMax);
+	} else {
+		rangeMin_ = lensMin;
+		rangeMax_ = lensMax;
+	}
+
+	infinity_ = tuningData["infinity"].get<int32_t>(rangeMin_);
+	macro_ = tuningData["macro"].get<int32_t>(rangeMax_);
+	if (macro_ == infinity_)
+		macro_ = infinity_ + 1;
+	maxDioptres_ = tuningData["maxDioptres"].get<float>(10.0f);
+	step_ = std::max(tuningData["step"].get<int32_t>((rangeMax_ - rangeMin_) / 16), 1);
+	settleFrames_ = tuningData["settleFrames"].get<uint32_t>(3);
+	rescanThreshold_ = tuningData["rescanThreshold"].get<double>(0.3);
+	minPeakRatio_ = tuningData["minPeakRatio"].get<double>(1.1);
+
+	int32_t initial = std::clamp(tuningData["default"].get<int32_t>(infinity_),
+				     rangeMin_, rangeMax_);
+	lensPosition_ = initial;
+
+	context.ctrlMap[&controls::AfMode] = ControlInfo(controls::AfModeValues,
+							 ControlValue(controls::AfModeManual));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfPause] = ControlInfo(controls::AfPauseValues);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, maxDioptres_, codeToDioptres(initial));
+
+	context.afEnabled = true;
+
+	LOG(IPASoftAf, Debug)
+		<< "Scan range " << rangeMin_ << "-" << rangeMax_
+		<< " step " << step_ << ", infinity " << infinity_
+		<< ", macro " << macro_ << " (" << maxDioptres_ << " dioptres)";
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	if (!context.afEnabled)
+		return 0;
+
+	/* The lens stays where it is, the mode and state start over. */
+	mode_ = controls::AfModeManual;
+	state_ = controls::AfStateIdle;
+	pauseState_ = controls::AfPauseStateRunning;
+	pauseDeferred_ = false;
+	scanning_ = false;
+	movedAt_.reset();
+	lastContrast_.reset();
+	context.activeState.af.lensPosition = lensPosition_;
+
+	return 0;
+}
+
+float Af::codeToDioptres(int32_t code) const
+{
+	float dioptres = maxDioptres_ * (code - infinity_) / (macro_ - infinity_);
+	return std::clamp(dioptres, 0.0f, maxDioptres_);
+}
+
+int32_t Af::dioptresToCode(float dioptres) const
+{
+	float code = infinity_ + (macro_ - infinity_) * dioptres / maxDioptres_;
+	return std::clamp(static_cast<int32_t>(std::lround(code)), rangeMin_, rangeMax_);
+}
+
+void Af::moveLens(IPAContext &context, int32_t position)
+{
+	lensPosition_ = std::clamp(position, rangeMin_, rangeMax_);
+	context.activeState.af.lensPosition = lensPosition_;
+	/* The frame of the move is set by the next process() call */
+	movedAt_.reset();
+}
+
+void Af::startScan(IPAContext &context)
+{
+	scanning_ = true;
+	state_ = controls::AfStateScanning;
+	scanPos_ = rangeMin_;
+	bestPos_ = rangeMin_;
+	bestContrast_ = 0.0;
+	minContrast_ = 0.0;
+	beforeBest_.reset();
+	afterBest_.reset();
+	prevContrast_.reset();
+	stepsPastBest_ = 0;
+	moveLens(context, scanPos_);
+
+	LOG(IPASoftAf, Debug) << "Scan started";
+}
+
+void Af::finishScan(IPAContext &context, bool success)
+{
+	int32_t target = bestPos_;
+
+	/* Interpolate the peak with a parabola through its neighbours */
+	if (success && beforeBest_ && afterBest_) {
+		double a = *beforeBest_, b = bestContrast_, c = *afterBest_;
+		double denominator = a - 2 * b + c;
+		if (denominator < 0) {
+			double offset = 0.5 * (a - c) / denominator;
+			target += static_cast<int32_t>(std::lround(offset * step_));
+		}
+	}
+
+	scanning_ = false;
+	state_ = success ? controls::AfStateFocused : controls::AfStateFailed;
+	focusedContrast_ = bestContrast_;
+	lastContrast_.reset();
+	stableCount_ = 0;
+	moveLens(context, target);
+
+	if (pauseDeferred_) {
+		pauseDeferred_ = false;
+		pauseState_ = controls::AfPauseStatePaused;
+	}
+
+	LOG(IPASoftAf, Debug)
+		<< "Scan " << (success ? "focused" : "failed") << " at " << target
+		<< " (best " << bestPos_ << ", contrast " << bestContrast_
+		<< ", lowest " << minContrast_ << ")";
+}
+
+void Af::scanStep(IPAContext &context, [[maybe_unused]] uint32_t frame, double contrast)
+{
+	LOG(IPASoftAf, Debug) << "Lens " << scanPos_ << " contrast " << contrast;
+
+	if (minContrast_ == 0.0 || contrast < minContrast_)
+		minContrast_ = contrast;
+
+	if (contrast > bestContrast_) {
+		/* The previous step, if any, is the neighbour before the peak */
+		beforeBest_ = prevContrast_;
+		afterBest_.reset();
+		bestContrast_ = contrast;
+		bestPos_ = scanPos_;
+		stepsPastBest_ = 0;
+	} else {
+		if (stepsPastBest_ == 0)
+			afterBest_ = contrast;
+		stepsPastBest_++;
+	}
+	prevContrast_ = contrast;
+
+	const bool peaked = bestContrast_ > minContrast_ * minPeakRatio_;
+
+	/* Stop once the contrast has dropped well below a clear peak */
+	if (peaked && stepsPastBest_ >= 2 && contrast < bestContrast_ * 0.7) {
+		finishScan(context, true);
+		return;
+	}
+
+	if (scanPos_ >= rangeMax_) {
+		finishScan(context, peaked);
+		return;
+	}
+
+	scanPos_ = std::min(scanPos_ + step_, rangeMax_);
+	moveLens(context, scanPos_);
+}
+
+void Af::monitor(IPAContext &context, double contrast)
+{
+	/*
+	 * Rescan when the contrast moved away from the focused value and has
+	 * been steady for two measurements: the scene (or its distance)
+	 * changed and settled.
+	 */
+	const bool changed = std::abs(contrast - focusedContrast_) >
+			     focusedContrast_ * rescanThreshold_;
+	const bool steady = lastContrast_ &&
+			    std::abs(contrast - *lastContrast_) < *lastContrast_ * 0.1;
+	lastContrast_ = contrast;
+
+	if (!changed) {
+		stableCount_ = 0;
+		/* Follow slow changes of the scene */
+		focusedContrast_ = 0.9 * focusedContrast_ + 0.1 * contrast;
+		return;
+	}
+
+	stableCount_ = steady ? stableCount_ + 1 : 0;
+	if (stableCount_ >= 2) {
+		LOG(IPASoftAf, Debug)
+			<< "Contrast changed from " << focusedContrast_
+			<< " to " << contrast << ", rescanning";
+		startScan(context);
+	}
+}
+
+void Af::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.afEnabled)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = static_cast<controls::AfModeEnum>(*mode);
+		scanning_ = false;
+		state_ = controls::AfStateIdle;
+		pauseState_ = controls::AfPauseStateRunning;
+		pauseDeferred_ = false;
+		if (mode_ == controls::AfModeContinuous)
+			startScan(context);
+	}
+
+	if (mode_ == controls::AfModeManual) {
+		const auto &position = controls.get(controls::LensPosition);
+		if (position)
+			moveLens(context, dioptresToCode(*position));
+	}
+
+	if (mode_ == controls::AfModeAuto) {
+		const auto &trigger = controls.get(controls::AfTrigger);
+		if (trigger && *trigger == controls::AfTriggerStart) {
+			startScan(context);
+		} else if (trigger && *trigger == controls::AfTriggerCancel) {
+			scanning_ = false;
+			state_ = controls::AfStateIdle;
+		}
+	}
+
+	if (mode_ == controls::AfModeContinuous) {
+		const auto &pause = controls.get(controls::AfPause);
+		if (!pause)
+			return;
+
+		switch (*pause) {
+		case controls::AfPauseImmediate:
+			if (scanning_) {
+				scanning_ = false;
+				state_ = controls::AfStateIdle;
+			}
+			pauseDeferred_ = false;
+			pauseState_ = controls::AfPauseStatePaused;
+			break;
+		case controls::AfPauseDeferred:
+			if (scanning_) {
+				pauseDeferred_ = true;
+				pauseState_ = controls::AfPauseStatePausing;
+			} else {
+				pauseState_ = controls::AfPauseStatePaused;
+			}
+			break;
+		case controls::AfPauseResume:
+			pauseDeferred_ = false;
+			if (pauseState_ == controls::AfPauseStatePaused && !scanning_ &&
+			    state_ == controls::AfStateIdle)
+				startScan(context);
+			pauseState_ = controls::AfPauseStateRunning;
+			break;
+		}
+	}
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.afEnabled)
+		return;
+
+	if (!movedAt_)
+		movedAt_ = frame;
+
+	if (stats->valid && stats->afSamples &&
+	    frame >= *movedAt_ + settleFrames_) {
+		double mean = static_cast<double>(stats->afSum) / stats->afSamples;
+		double contrast = static_cast<double>(stats->afSharpness) /
+				  stats->afSamples / std::max(mean * mean, 1.0);
+
+		if (scanning_)
+			scanStep(context, frame, contrast);
+		else if (mode_ == controls::AfModeContinuous &&
+			 pauseState_ == controls::AfPauseStateRunning &&
+			 state_ != controls::AfStateIdle)
+			monitor(context, contrast);
+	}
+
+	metadata.set(controls::AfState, state_);
+	if (mode_ == controls::AfModeContinuous)
+		metadata.set(controls::AfPauseState, pauseState_);
+	metadata.set(controls::LensPosition,
+		     codeToDioptres(context.activeState.af.lensPosition));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
