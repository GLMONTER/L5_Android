+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <optional>
+#include <stdint.h>
+
+#include <libcamera/controls.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	void startScan(IPAContext &context);
+	void finishScan(IPAContext &context, bool success);
+	void scanStep(IPAContext &context, uint32_t frame, double contrast);
+	void monitor(IPAContext &context, double contrast);
+	void moveLens(IPAContext &context, int32_t position);
+
+	float codeToDioptres(int32_t code) const;
+	int32_t dioptresToCode(float dioptres) const;
+
+	/* Tuning */
+	int32_t rangeMin_ = 0;
+	int32_t rangeMax_ = 0;
+	int32_t infinity_ = 0;
+	int32_t macro_ = 0;
+	float maxDioptres_ = 10.0f;
+	int32_t step_ = 0;
+	unsigned int settleFrames_ = 3;
+	double rescanThreshold_ = 0.3;
+	double minPeakRatio_ = 1.1;
+
+	/* Lens position, kept across configurations */
+	int32_t lensPosition_ = 0;
+
+	/* Controls */
+	controls::AfModeEnum mode_ = controls::AfModeManual;
+	controls::AfStateEnum state_ = controls::AfStateIdle;
+	controls::AfPauseStateEnum pauseState_ = controls::AfPauseStateRunning;
+	bool pauseDeferred_ = false;
+
+	/* Scan */
+	bool scanning_ = false;
+	int32_t scanPos_ = 0;
+	int32_t bestPos_ = 0;
+	double bestContrast_ = 0.0;
+	double minContrast_ = 0.0;
+	/* Contrast one step before and after the best position */
+	std::optional<double> beforeBest_;
+	std::optional<double> afterBest_;
+	std::optional<double> prevContrast_;
+	unsigned int stepsPastBest_ = 0;
+	std::optional<uint32_t> movedAt_;
+
+	/* Continuous mode */
+	double focusedContrast_ = 0.0;
+	std::optional<double> lastContrast_;
+	unsigned int stableCount_ = 0;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
