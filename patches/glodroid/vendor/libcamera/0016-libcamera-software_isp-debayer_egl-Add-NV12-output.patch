+			     outputNV12_ ? formats::ARGB8888 : outputPixelFormat_))
+		return -EINVAL;
+
+	if (outputNV12_ && initNV12Shaders())
 		return -EINVAL;
 
 	if (lscEnabled_) {
@@ -710,6 +876,13 @@ void DebayerEGL::stop()
 {
 	eglImageOutCache_.clear();
 	eglImageInCache_.clear();
+	nv12OutCache_.clear();
+	rgbImage_.reset();
+
+	for (NV12Program *program : { &nv12Y_, &nv12UV_ }) {
+		if (program->id)
+			glDeleteProgram(std::exchange(program->id, 0));
+	}
 
 	eglImageLscLookup_.reset();
 	lscLutVersion_.reset();
