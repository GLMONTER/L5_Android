+	bool outputNV12_ = false;
+	std::optional<eGLImage> rgbImage_;
+	std::deque<std::pair<SharedFD, NV12Planes>> nv12OutCache_;
+	NV12Program nv12Y_;
+	NV12Program nv12UV_;
 	unsigned int inputBufferCount_;
 	unsigned int outputBufferCount_;
 
