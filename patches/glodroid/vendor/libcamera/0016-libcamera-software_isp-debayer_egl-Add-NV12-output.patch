@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * rgb_to_nv12.frag - Convert an RGB texture to one plane of NV12
+ *
+ * Each fragment writes four bytes of the plane, rendered to the plane as an
+ * ARGB8888 image of a quarter of its width (bytes B, G, R, A in memory):
+ * - Y (default): the luma of four adjacent pixels
+ * - UV (NV12_UV defined): Cb and Cr of two adjacent 2x2 pixel blocks, each
+ *   block averaged by a single bilinear fetch at its centre
+ *
+ * Full range BT.601, as for JPEG.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+uniform sampler2D rgb_tex;
+/* Size of rgb_tex in pixels */
+uniform vec2 rgb_size;
+
+const vec3 kY = vec3(0.299, 0.587, 0.114);
+const vec3 kCb = vec3(-0.168736, -0.331264, 0.5);
+const vec3 kCr = vec3(0.5, -0.418688, -0.081312);
+
+vec3 rgbAt(float x, float y)
+{
+	return texture2D(rgb_tex, vec2(x, y) / rgb_size).rgb;
+}
+
+void main(void)
+{
+	float x = floor(gl_FragCoord.x) * 4.0;
+
+#if defined(NV12_UV)
+	float y = floor(gl_FragCoord.y) * 2.0 + 1.0;
+	vec3 c0 = rgbAt(x + 1.0, y);
+	vec3 c1 = rgbAt(x + 3.0, y);
+	const float offset = 128.0 / 255.0;
+
+	gl_FragColor = vec4(dot(c1, kCb) + offset, dot(c0, kCr) + offset,
+			    dot(c0, kCb) + offset, dot(c1, kCr) + offset);
+#else
+	float y = gl_FragCoord.y;
+
+	gl_FragColor = vec4(dot(rgbAt(x + 2.5, y), kY), dot(rgbAt(x + 1.5, y), kY),
+			    dot(rgbAt(x + 0.5, y), kY), dot(rgbAt(x + 3.5, y), kY));
+#endif
+}
