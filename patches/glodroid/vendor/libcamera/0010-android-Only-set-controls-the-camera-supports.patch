From a2117fb7e2fe173d5df0b6d14750e6631dc48e99 Mon Sep 17 00:00:00 2001
From: tad <tad.keller@pm.me>
Date: Mon, 2 Nov 2026 23:01:37 -0600
Subject: [PATCH] android: Only set controls the camera supports

processControls() translates the scaler crop region, face detection and
test pattern settings of every request into libcamera controls whether
or not the camera supports them. Unsupported controls fail validation
in ControlList::set(), which logs an error for each one, on every
request (two per frame with the simple pipeline handler).

Skip the controls that are not in the camera's ControlInfoMap.
---
 src/android/camera_device.cpp | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
index 0c54d92..e97ed8e 100644
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -908,10 +908,19 @@ int CameraDevice::processControls(Camera3RequestDescriptor *descriptor)
 	if (!settings.isValid())
 		return 0;
 
-	/* Translate the Android request settings to libcamera controls. */
+	/*
+	 * Translate the Android request settings to libcamera controls, for
+	 * the controls the camera supports: setting others fails the control
+	 * validation, which logs an error for every request.
+	 */
 	ControlList &controls = descriptor->request_->controls();
+	const ControlInfoMap &supported = camera_->controls();
+	auto isSupported = [&](const ControlId &id) {
+		return supported.find(&id) != supported.end();
+	};
 	camera_metadata_ro_entry_t entry;
-	if (settings.getEntry(ANDROID_SCALER_CROP_REGION, &entry)) {
+	if (isSupported(controls::ScalerCrop) &&
+	    settings.getEntry(ANDROID_SCALER_CROP_REGION, &entry)) {
 		const int32_t *data = entry.data.i32;
 		Rectangle cropRegion{ data[0], data[1],
 				      static_cast<unsigned int>(data[2]),
@@ -919,12 +928,14 @@ int CameraDevice::processControls(Camera3RequestDescriptor *descriptor)
 		controls.set(controls::ScalerCrop, cropRegion);
 	}
 
-	if (settings.getEntry(ANDROID_STATISTICS_FACE_DETECT_MODE, &entry)) {
+	if (isSupported(controls::draft::FaceDetectMode) &&
+	    settings.getEntry(ANDROID_STATISTICS_FACE_DETECT_MODE, &entry)) {
 		const uint8_t *data = entry.data.u8;
 		controls.set(controls::draft::FaceDetectMode, data[0]);
 	}
 
-	if (settings.getEntry(ANDROID_SENSOR_TEST_PATTERN_MODE, &entry)) {
+	if (isSupported(controls::draft::TestPatternMode) &&
+	    settings.getEntry(ANDROID_SENSOR_TEST_PATTERN_MODE, &entry)) {
 		const int32_t data = *entry.data.i32;
 		int32_t testPatternMode = controls::draft::TestPatternModeOff;
 		switch (data) {
-- 
