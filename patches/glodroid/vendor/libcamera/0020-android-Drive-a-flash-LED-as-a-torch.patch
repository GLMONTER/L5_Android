+/*
+ * Torch mode of the flash LED while the camera is closed: the camera3 module
+ * set_torch_mode() operation.
+ */
+int CameraDevice::setTorchMode(bool on)
+{
+	if (!flash_)
+		return -ENOSYS;
+
+	if (opened_)
+		return -EBUSY;
+
+	int ret = flash_->setTorch(on);
+	if (ret)
+		return ret;
+
+	notifyTorchStatus(on ? TORCH_MODE_STATUS_AVAILABLE_ON
+			     : TORCH_MODE_STATUS_AVAILABLE_OFF);
+	return 0;
