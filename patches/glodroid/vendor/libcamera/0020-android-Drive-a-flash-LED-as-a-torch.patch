+/* Turn the torch on at a strength level (FLASH_INFO_STRENGTH_MAXIMUM_LEVEL) */
+int CameraDevice::setTorchStrength(int32_t level)
+{
+	if (!flash_)
+		return -ENOSYS;
+
+	if (opened_)
+		return -EBUSY;
+
+	if (level < 1)
+		return -EINVAL;
+
+	int ret = flash_->setTorchLevel(level);
+	if (ret)
+		return ret;
+
+	notifyTorchStatus(TORCH_MODE_STATUS_AVAILABLE_ON);
+	return 0;
+}
+
+int CameraDevice::torchStrength(int32_t *level) const
+{
+	if (!flash_)
+		return -ENOSYS;
+
+	*level = flash_->level();
+	return 0;
