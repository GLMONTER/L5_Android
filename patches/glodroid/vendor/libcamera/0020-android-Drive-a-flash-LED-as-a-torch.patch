diff --git a/src/android/flash_led.cpp b/src/android/flash_led.cpp
new file mode 100644
index 0000000..8a89364
--- /dev/null
+++ b/src/android/flash_led.cpp
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Flash LED of a camera, driven through the LED class (/sys/class/leds)
+ */
+
+#include "flash_led.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <libcamera/base/log.h>
+
+using namespace libcamera;
+
+LOG_DECLARE_CATEGORY(HAL)
+
+/*
+ * \class FlashLed
+ * \brief A camera flash LED in torch mode
+ *
+ * The LED is named by its LED class device (e.g. "white:torch"). In torch
+ * mode it is lit continuously at a strength level, an LED class brightness
+ * from 1 to max_brightness, which flash LED drivers keep within the torch
+ * current limit. The level defaults to the maximum.
+ */
+
+int FlashLed::init(const std::string &name)
+{
+	const std::string dir = "/sys/class/leds/" + name;
+	char buf[16] = {};
+
+	int fd = open((dir + "/max_brightness").c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		int ret = -errno;
+		LOG(HAL, Error) << "Flash LED " << name << ": " << strerror(-ret);
+		return ret;
+	}
+	ssize_t len = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+
+	maxBrightness_ = len > 0 ? strtoul(buf, nullptr, 10) : 0;
+	if (!maxBrightness_) {
+		LOG(HAL, Error) << "Flash LED " << name << " has no brightness levels";
+		return -EINVAL;
+	}
+
+	brightnessPath_ = dir + "/brightness";
+	level_ = maxBrightness_;
+
+	return setTorch(false);
+}
+
+int FlashLed::setTorchLevel(unsigned int level)
+{
+	if (level < 1 || level > maxBrightness_)
+		return -EINVAL;
+
+	level_ = level;
+	return setTorch(true);
+}
+
+int FlashLed::setTorch(bool on)
+{
+	const std::string value = std::to_string(on ? level_ : 0);
+
+	int fd = open(brightnessPath_.c_str(), O_WRONLY | O_CLOEXEC);
+	if (fd < 0) {
+		int ret = -errno;
+		LOG(HAL, Error) << "Flash LED: " << strerror(-ret);
+		return ret;
+	}
+	ssize_t len = write(fd, value.c_str(), value.size());
+	int ret = len < 0 ? -errno : 0;
+	close(fd);
+
+	if (ret) {
+		LOG(HAL, Error) << "Flash LED: " << strerror(-ret);
+		return ret;
+	}
+
+	torch_ = on;
+	return 0;
+}
