+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Flash LED of a camera, driven through the LED class (/sys/class/leds)
+ */
+
+#pragma once
+
+#include <string>
+
+class FlashLed
+{
+public:
+	int init(const std::string &name);
+
+	bool torch() const { return torch_; }
+	int setTorch(bool on);
+
+	/* Torch strength levels: the LED class brightness, 1 to maxLevel() */
+	unsigned int maxLevel() const { return maxBrightness_; }
+	unsigned int level() const { return level_; }
+	int setTorchLevel(unsigned int level);
+
+private:
+	std::string brightnessPath_;
+	unsigned int maxBrightness_ = 0;
+	unsigned int level_ = 0;
+	bool torch_ = false;
+};
