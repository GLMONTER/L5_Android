From b540ac7b022ebe60f54671057dfc4339a247f6ac Mon Sep 17 00:00:00 2001
From: tad <tad.keller@pm.me>
Date: Tue, 3 Nov 2026 16:28:58 -0600
Subject: [PATCH] avutil/hwcontext_v4l2request: work without libudev and libc's
 v4l2_timeval_to_ns

Android has neither libudev nor the uAPI's inline v4l2_timeval_to_ns()
(bionic's copies of the kernel headers leave inline functions out).

Make libudev optional: without it, scan /dev for media devices and find
the video node of each media interface by its device number. Compute the
CAPTURE timestamp directly instead of calling v4l2_timeval_to_ns(), and
check for linux/media.h directly: it was only enabled as a side effect
of the v4l2_timeval_to_ns check.
---
 configure                         |  3 +-
 libavcodec/v4l2_request.c         |  5 +-
 libavutil/hwcontext_v4l2request.c | 92 +++++++++++++++++++++++++++++--
 3 files changed, 94 insertions(+), 6 deletions(-)

diff --git a/configure b/configure
index 6c77755..20cb4ae 100755
--- a/configure
+++ b/configure
@@ -3353,7 +3353,7 @@ dxva2_deps="dxva2api_h DXVA2_ConfigPictureDecode ole32 user32"
 ffnvcodec_deps_any="libdl LoadLibrary"
 mediacodec_deps="android mediandk pthreads"
 nvdec_deps="ffnvcodec"
-v4l2_request_deps="linux_media_h v4l2_timeval_to_ns v4l2_m2m_hold_capture_buf libdrm libudev"
+v4l2_request_deps="linux_media_h v4l2_m2m_hold_capture_buf libdrm"
 v4l2_request_suggest="libdrm libudev"
 vaapi_x11_deps="xlib_x11"
 videotoolbox_hwaccel_deps="videotoolbox pthreads"
@@ -7624,6 +7624,7 @@ if enabled v4l2_request; then
     check_cc v4l2_m2m_hold_capture_buf linux/videodev2.h "int i = V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF"
     check_cc vp8_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_VP8_FRAME"
     check_cc vp9_v4l2_request linux/videodev2.h "int i = V4L2_CID_STATELESS_VP9_FRAME"
+    check_headers linux/media.h
     check_func_headers "linux/media.h linux/videodev2.h" v4l2_timeval_to_ns
     check_pkg_config libudev libudev libudev.h udev_new
     check_struct linux/videodev2.h "struct v4l2_ctrl_hevc_decode_params" num_delta_pocs_of_ref_rps_idx
diff --git a/libavcodec/v4l2_request.c b/libavcodec/v4l2_request.c
index 36eec85..a8fa7ba 100644
--- a/libavcodec/v4l2_request.c
+++ b/libavcodec/v4l2_request.c
@@ -59,7 +59,10 @@ uint64_t ff_v4l2_request_get_capture_timestamp(AVFrame *frame)
         .tv_sec = 0,
         .tv_usec = v4l2_request_frameindex(frame) + 1,
     };
-    return v4l2_timeval_to_ns(&timestamp);
+    /* Same as the uAPI's inline v4l2_timeval_to_ns(), which some libc
+     * copies of the kernel headers (Android's bionic) leave out. */
+    return (uint64_t)timestamp.tv_sec * 1000000000ULL +
+           (uint64_t)timestamp.tv_usec * 1000;
 }
 
 int ff_v4l2_request_query_control(AVCodecContext *avctx,
diff --git a/libavutil/hwcontext_v4l2request.c b/libavutil/hwcontext_v4l2request.c
index f99eea6..66639a0 100644
--- a/libavutil/hwcontext_v4l2request.c
+++ b/libavutil/hwcontext_v4l2request.c
@@ -26,7 +26,15 @@
 #include <unistd.h>
 
 #include <drm_fourcc.h>
+#if CONFIG_LIBUDEV
 #include <libudev.h>
+#else
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#endif
 
 #include "avassert.h"
 #include "hwcontext_drm.h"
@@ -491,8 +499,33 @@ fail:
     return ret;
 }
 
+#if !CONFIG_LIBUDEV
+/*
+ * Without libudev (e.g. Android): find the /dev node of a character device
+ * by its device number. Probe /dev/videoN by name rather than listing /dev,
+ * which sandboxed media services may not be allowed to read.
+ */
+#define V4L2REQUEST_MAX_DEVNODES 64
+
+static char *v4l2request_find_devnode(dev_t devnum)
+{
+    char path[PATH_MAX];
+    struct stat st;
+
+    for (int i = 0; i < V4L2REQUEST_MAX_DEVNODES; i++) {
+        snprintf(path, sizeof(path), "/dev/video%d", i);
+        if (!stat(path, &st) && S_ISCHR(st.st_mode) && st.st_rdev == devnum)
+            return av_strdup(path);
+    }
+
+    return NULL;
+}
+#endif
+
 static int v4l2request_probe_video_devices(AVHWFramesContext *hwfc,
+#if CONFIG_LIBUDEV
                                            struct udev *udev,
+#endif
                                            uint32_t pixelformat,
                                            uint32_t buffersize)
 {
@@ -501,8 +534,12 @@ static int v4l2request_probe_video_devices(AVHWFramesContext *hwfc,
     struct media_device_info device_info;
     struct media_v2_topology topology = {0};
     struct media_v2_interface *interfaces;
+#if CONFIG_LIBUDEV
     struct udev_device *device;
     const char *path;
+#else
+    char *path;
+#endif
     dev_t devnum;
     int ret;
 
@@ -537,6 +574,7 @@ static int v4l2request_probe_video_devices(AVHWFramesContext *hwfc,
             continue;
 
         devnum = makedev(interfaces[i].devnode.major, interfaces[i].devnode.minor);
+#if CONFIG_LIBUDEV
         device = udev_device_new_from_devnum(udev, 'c', devnum);
         if (!device)
             continue;
@@ -545,6 +583,14 @@ static int v4l2request_probe_video_devices(AVHWFramesContext *hwfc,
         if (path)
             ret = v4l2request_probe_video_device(hwfc, path, pixelformat, buffersize);
         udev_device_unref(device);
+#else
+        path = v4l2request_find_devnode(devnum);
+        if (!path)
+            continue;
+
+        ret = v4l2request_probe_video_device(hwfc, path, pixelformat, buffersize);
+        av_free(path);
+#endif
 
         // Stop when we have found a capable video device
         if (!ret) {
@@ -565,18 +611,23 @@ fail:
 }
 
 static int v4l2request_probe_media_device(AVHWFramesContext *hwfc,
+#if CONFIG_LIBUDEV
                                           struct udev_device *device,
+#else
+                                          const char *path,
+#endif
                                           uint32_t pixelformat,
                                           uint32_t buffersize)
 {
     AVV4L2RequestFramesContext *fctx = hwfc->hwctx;
     AVV4L2RequestFramesContextInternal *fctxi = fctx->internal;
-    const char *path;
     int ret;
 
-    path = udev_device_get_devnode(device);
+#if CONFIG_LIBUDEV
+    const char *path = udev_device_get_devnode(device);
     if (!path)
         return AVERROR(ENODEV);
+#endif
 
     // Open enumerated media device
     fctxi->media_fd = open(path, O_RDWR);
@@ -588,8 +639,12 @@ static int v4l2request_probe_media_device(AVHWFramesContext *hwfc,
     }
 
     // Probe video devices of current media device
+#if CONFIG_LIBUDEV
     ret = v4l2request_probe_video_devices(hwfc, udev_device_get_udev(device),
                                           pixelformat, buffersize);
+#else
+    ret = v4l2request_probe_video_devices(hwfc, pixelformat, buffersize);
+#endif
 
     // Cleanup when no capable video device was found
     if (ret < 0) {
@@ -600,6 +655,7 @@ static int v4l2request_probe_media_device(AVHWFramesContext *hwfc,
     return ret;
 }
 
+#if CONFIG_LIBUDEV
 static int v4l2request_probe_media_devices(AVHWFramesContext *hwfc,
                                            struct udev *udev,
                                            uint32_t pixelformat,
@@ -641,12 +697,35 @@ static int v4l2request_probe_media_devices(AVHWFramesContext *hwfc,
     udev_enumerate_unref(enumerate);
     return ret;
 }
+#else
+static int v4l2request_probe_media_devices(AVHWFramesContext *hwfc,
+                                           uint32_t pixelformat,
+                                           uint32_t buffersize)
+{
+    char path[PATH_MAX];
+    struct stat st;
+    int ret = AVERROR(ENOENT);
+
+    for (int i = 0; ret && i < V4L2REQUEST_MAX_DEVNODES; i++) {
+        snprintf(path, sizeof(path), "/dev/media%d", i);
+        if (stat(path, &st) || !S_ISCHR(st.st_mode))
+            continue;
+
+        // Probe media device for a capable video device
+        ret = v4l2request_probe_media_device(hwfc, path, pixelformat, buffersize);
+    }
+
+    return ret;
+}
+#endif
 
 static int v4l2request_open_decoder(AVHWFramesContext *hwfc)
 {
     AVV4L2RequestFramesContext *fctx = hwfc->hwctx;
     uint32_t buffersize;
+#if CONFIG_LIBUDEV
     struct udev *udev;
+#endif
     int ret;
 
     // Ensure codec pixelformat is set
@@ -655,16 +734,21 @@ static int v4l2request_open_decoder(AVHWFramesContext *hwfc)
 
     // FIXME: locate a decoder using hwdevice context decoders
 
+    buffersize = FFMAX(hwfc->width * hwfc->height * 3 / 2, 256 * 1024);
+
+#if CONFIG_LIBUDEV
     udev = udev_new();
     if (!udev)
         return AVERROR(ENOMEM);
 
-    buffersize = FFMAX(hwfc->width * hwfc->height * 3 / 2, 256 * 1024);
-
     // Probe all media devices (auto-detection)
     ret = v4l2request_probe_media_devices(hwfc, udev, fctx->pixelformat, buffersize);
 
     udev_unref(udev);
+#else
+    // Probe all media devices (auto-detection)
+    ret = v4l2request_probe_media_devices(hwfc, fctx->pixelformat, buffersize);
+#endif
     return ret;
 }
 
-- 
