+#pragma once
+
+#include <mutex>
+#include <optional>
+#include <string>
+
+#include <aidl/android/media/audio/common/AudioDevice.h>
+
+struct audio_route;
+
+namespace aidl::android::hardware::audio::core::primary {
+
+// Optional codec routing for the primary module: if /vendor/etc/mixer_paths.xml exists
+// (audio_route format), its top-level controls are applied at startup and the path that
+// matches the connected device type is applied whenever a primary stream changes device.
+// Path names: "speaker", "earpiece", "headphones", "builtin-mic", "headset-mic".
+class PrimaryRoute {
+  public:
+    static PrimaryRoute& getInstance();
+
+    void select(bool isInput,
+                const std::optional<::aidl::android::media::audio::common::AudioDevice>& device);
+
+  private:
+    PrimaryRoute();
+
+    std::mutex mLock;
+    struct audio_route* mRoute = nullptr;
+    std::string mOutputPath;
+    std::string mInputPath;
+};
+
+}  // namespace aidl::android::hardware::audio::core::primary
