+#define LOG_TAG "AHAL_PrimaryRoute"
+
+#include <unistd.h>
+
+#include <android-base/logging.h>
+#include <audio_route/audio_route.h>
+
+#include "PrimaryMixer.h"
+#include "PrimaryRoute.h"
+
+using aidl::android::media::audio::common::AudioDevice;
+using aidl::android::media::audio::common::AudioDeviceType;
+
+namespace aidl::android::hardware::audio::core::primary {
+
+namespace {
+
+constexpr char kMixerPathsFile[] = "/vendor/etc/mixer_paths.xml";
+
+std::string pathForDevice(bool isInput, const AudioDevice& device) {
+    switch (device.type.type) {
+        case AudioDeviceType::OUT_SPEAKER:
+            return "speaker";
+        case AudioDeviceType::OUT_SPEAKER_EARPIECE:
+            return "earpiece";
+        case AudioDeviceType::OUT_HEADPHONE:
+        case AudioDeviceType::OUT_HEADSET:
+            return "headphones";
+        case AudioDeviceType::IN_MICROPHONE:
+        case AudioDeviceType::IN_MICROPHONE_BACK:
+            return "builtin-mic";
+        case AudioDeviceType::IN_HEADSET:
+            return "headset-mic";
+        default:
+            LOG(DEBUG) << __func__ << ": no path for " << (isInput ? "input" : "output")
+                       << " device " << device.toString();
+            return "";
+    }
+}
+
+}  // namespace
+
+PrimaryRoute& PrimaryRoute::getInstance() {
+    static PrimaryRoute instance;
+    return instance;
+}
+
+PrimaryRoute::PrimaryRoute() {
+    if (access(kMixerPathsFile, R_OK) != 0) {
+        LOG(INFO) << __func__ << ": " << kMixerPathsFile << " not present, routing disabled";
+        return;
+    }
+    mRoute = audio_route_init(PrimaryMixer::kAlsaCard, kMixerPathsFile);
+    if (mRoute == nullptr) {
+        LOG(ERROR) << __func__ << ": failed to load " << kMixerPathsFile;
+        return;
+    }
+    LOG(INFO) << __func__ << ": loaded " << kMixerPathsFile << " for card "
+              << PrimaryMixer::kAlsaCard;
+}
+
+void PrimaryRoute::select(bool isInput, const std::optional<AudioDevice>& device) {
+    if (mRoute == nullptr) return;
+    std::lock_guard l(mLock);
+    std::string& current = isInput ? mInputPath : mOutputPath;
+    std::string next = device.has_value() ? pathForDevice(isInput, *device) : "";
+    if (next == current) return;
+    if (!current.empty()) audio_route_reset_path(mRoute, current.c_str());
+    if (!next.empty() && audio_route_apply_path(mRoute, next.c_str()) != 0) {
+        LOG(WARNING) << __func__ << ": no path \"" << next << "\" in " << kMixerPathsFile;
+        next.clear();
+    }
+    audio_route_update_mixer(mRoute);
+    LOG(INFO) << __func__ << ": " << (isInput ? "input" : "output") << " path \"" << current
+              << "\" -> \"" << next << "\"";
+    current = next;
+}
+
+}  // namespace aidl::android::hardware::audio::core::primary
