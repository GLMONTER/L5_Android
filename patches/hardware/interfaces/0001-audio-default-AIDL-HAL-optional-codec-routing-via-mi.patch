 audio/aidl/default/primary/PrimaryRoute.cpp  | 95 ++++++++++++++++++++
 audio/aidl/default/primary/PrimaryRoute.h    | 49 ++++++++++
 audio/aidl/default/primary/StreamPrimary.cpp |  6 +-
 4 files changed, 151 insertions(+), 1 deletion(-)
