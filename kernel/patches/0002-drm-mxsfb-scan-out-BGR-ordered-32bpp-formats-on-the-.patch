From e542590b272ae8aaf1addae26f6667df2f6f620c Mon Sep 17 00:00:00 2001
From: tad <tad.keller@pm.me>
Date: Mon, 2 Nov 2026 13:36:47 -0600
Subject: [PATCH 2/3] drm: mxsfb: scan out BGR-ordered 32bpp formats on the
 primary plane

Android's SurfaceFlinger always allocates its client target for physical
displays as RGBA_8888 (DRM ABGR8888), which the LCDIF primary plane did
not accept, so nothing reached the panel.

Accept XBGR8888/ABGR8888 (and ARGB8888, alpha ignored) and swap red and
blue on the output with the LCDIF V4 CTRL2 odd/even line patterns. The
pattern is set at modeset and on every primary plane update, since the
format may change between flips.
---
 drivers/gpu/drm/mxsfb/mxsfb_drv.c  |  6 ++++
 drivers/gpu/drm/mxsfb/mxsfb_drv.h  |  4 +++
 drivers/gpu/drm/mxsfb/mxsfb_kms.c  | 57 +++++++++++++++++++++++++++++-
 drivers/gpu/drm/mxsfb/mxsfb_regs.h |  5 +++
 4 files changed, 71 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/mxsfb/mxsfb_drv.c b/drivers/gpu/drm/mxsfb/mxsfb_drv.c
index 909fd3ae8..c51fdfc0d 100644
--- a/drivers/gpu/drm/mxsfb/mxsfb_drv.c
+++ b/drivers/gpu/drm/mxsfb/mxsfb_drv.c
@@ -165,6 +165,12 @@ static irqreturn_t mxsfb_irq_handler(int irq, void *data)
 	reg = readl(mxsfb->base + LCDC_CTRL1);
 
 	if (reg & CTRL1_CUR_FRAME_DONE_IRQ) {
+		int pattern = READ_ONCE(mxsfb->pending_rgb_pattern);
+
+		if (pattern >= 0) {
+			mxsfb_write_rgb_pattern(mxsfb, pattern);
+			WRITE_ONCE(mxsfb->pending_rgb_pattern, -1);
+		}
 		mxsfb_crtc_handle_vblank(mxsfb);
 		if (mxsfb->crc_active) {
 			crc = readl(mxsfb->base + LCDC_V4_CRC_STAT);
diff --git a/drivers/gpu/drm/mxsfb/mxsfb_drv.h b/drivers/gpu/drm/mxsfb/mxsfb_drv.h
index aaf7073d5..fd615d892 100644
--- a/drivers/gpu/drm/mxsfb/mxsfb_drv.h
+++ b/drivers/gpu/drm/mxsfb/mxsfb_drv.h
@@ -48,6 +48,9 @@ struct mxsfb_drm_private {
 
 	bool				crc_active;
 
+	/* CTRL2 RGB line pattern to apply at the next frame boundary, or -1 */
+	int				pending_rgb_pattern;
+
 	/* Protected by drm->event_lock */
 	struct drm_pending_vblank_event	*event;
 
@@ -65,5 +68,6 @@ void mxsfb_disable_axi_clk(struct mxsfb_drm_private *mxsfb);
 
 int mxsfb_kms_init(struct mxsfb_drm_private *mxsfb);
 void mxsfb_crtc_handle_vblank(struct mxsfb_drm_private *mxsfb);
+void mxsfb_write_rgb_pattern(struct mxsfb_drm_private *mxsfb, u32 pattern);
 
 #endif /* __MXSFB_DRV_H__ */
diff --git a/drivers/gpu/drm/mxsfb/mxsfb_kms.c b/drivers/gpu/drm/mxsfb/mxsfb_kms.c
index 69fae1117..d8a1e6896 100644
--- a/drivers/gpu/drm/mxsfb/mxsfb_kms.c
+++ b/drivers/gpu/drm/mxsfb/mxsfb_kms.c
@@ -49,6 +49,42 @@ static u32 set_hsync_pulse_width(struct mxsfb_drm_private *mxsfb, u32 val)
  * Setup the MXSFB registers for decoding the pixels out of the framebuffer and
  * outputting them on the bus.
  */
+/*
+ * Output component order. The LCDIF reads 32bpp pixels as XRGB; for the
+ * BGR-ordered formats (XBGR8888/ABGR8888, i.e. Android's RGBX/RGBA) swap
+ * red and blue on the output with the CTRL2 line patterns.
+ */
+static u32 mxsfb_rgb_pattern(u32 format)
+{
+	switch (format) {
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ABGR8888:
+		return CTRL2_LINE_PATTERN_BGR;
+	default:
+		return CTRL2_LINE_PATTERN_RGB;
+	}
+}
+
+void mxsfb_write_rgb_pattern(struct mxsfb_drm_private *mxsfb, u32 pattern)
+{
+	u32 reg;
+
+	if (!mxsfb->devdata->has_ctrl2)
+		return;
+
+	reg = readl(mxsfb->base + LCDC_V4_CTRL2);
+	reg &= ~CTRL2_LINE_PATTERN_MASK;
+	reg |= CTRL2_ODD_LINE_PATTERN(pattern) | CTRL2_EVEN_LINE_PATTERN(pattern);
+	writel(reg, mxsfb->base + LCDC_V4_CTRL2);
+}
+
+/* Modeset path: the controller is stopped, apply right away. */
+static void mxsfb_set_rgb_order(struct mxsfb_drm_private *mxsfb, u32 format)
+{
+	WRITE_ONCE(mxsfb->pending_rgb_pattern, -1);
+	mxsfb_write_rgb_pattern(mxsfb, mxsfb_rgb_pattern(format));
+}
+
 static void mxsfb_set_formats(struct mxsfb_drm_private *mxsfb,
 			      const u32 bus_format)
 {
@@ -72,7 +108,10 @@ static void mxsfb_set_formats(struct mxsfb_drm_private *mxsfb,
 		ctrl1 |= CTRL1_SET_BYTE_PACKAGING(0xf);
 		break;
 	case DRM_FORMAT_XRGB8888:
-		dev_dbg(drm->dev, "Setting up XRGB8888 mode\n");
+	case DRM_FORMAT_ARGB8888:	/* alpha ignored on the primary plane */
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ABGR8888:
+		dev_dbg(drm->dev, "Setting up 32bpp mode (%p4cc)\n", &format);
 		ctrl |= CTRL_WORD_LENGTH_24;
 		/* Do not use packed pixels = one pixel per word instead. */
 		ctrl1 |= CTRL1_SET_BYTE_PACKAGING(0x7);
@@ -96,6 +135,7 @@ static void mxsfb_set_formats(struct mxsfb_drm_private *mxsfb,
 
 	writel(ctrl1, mxsfb->base + LCDC_CTRL1);
 	writel(ctrl, mxsfb->base + LCDC_CTRL);
+	mxsfb_set_rgb_order(mxsfb, format);
 }
 
 static void mxsfb_set_mode(struct mxsfb_drm_private *mxsfb, u32 bus_flags)
@@ -678,6 +718,16 @@ static void mxsfb_plane_primary_atomic_update(struct drm_plane *plane,
 	dma_addr = drm_fb_dma_get_gem_addr(new_pstate->fb, new_pstate, 0);
 	if (dma_addr)
 		writel(dma_addr, mxsfb->base + mxsfb->devdata->next_buf);
+
+	/*
+	 * The format may change between flips without a modeset. NEXT_BUF only
+	 * takes effect at the next frame boundary, while CTRL2 applies at once,
+	 * so hand the pattern to the frame-done IRQ to switch both together
+	 * (otherwise one frame shows red and blue swapped).
+	 */
+	if (new_pstate->fb)
+		WRITE_ONCE(mxsfb->pending_rgb_pattern,
+			   mxsfb_rgb_pattern(new_pstate->fb->format->format));
 }
 
 static void mxsfb_plane_overlay_atomic_update(struct drm_plane *plane,
@@ -782,6 +832,9 @@ static const struct drm_plane_funcs mxsfb_plane_funcs = {
 static const uint32_t mxsfb_primary_plane_formats[] = {
 	DRM_FORMAT_RGB565,
 	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_ABGR8888,
 };
 
 static const uint32_t mxsfb_overlay_plane_formats[] = {
@@ -809,6 +862,8 @@ int mxsfb_kms_init(struct mxsfb_drm_private *mxsfb)
 	struct drm_crtc *crtc = &mxsfb->crtc;
 	int ret;
 
+	mxsfb->pending_rgb_pattern = -1;
+
 	drm_plane_helper_add(&mxsfb->planes.primary,
 			     &mxsfb_plane_primary_helper_funcs);
 	ret = drm_universal_plane_init(mxsfb->drm, &mxsfb->planes.primary, 1,
diff --git a/drivers/gpu/drm/mxsfb/mxsfb_regs.h b/drivers/gpu/drm/mxsfb/mxsfb_regs.h
index ea4b729bc..4295a2283 100644
--- a/drivers/gpu/drm/mxsfb/mxsfb_regs.h
+++ b/drivers/gpu/drm/mxsfb/mxsfb_regs.h
@@ -69,6 +69,11 @@
 #define CTRL2_SET_OUTSTANDING_REQS_8	(0x3 << 21)
 #define CTRL2_SET_OUTSTANDING_REQS_16	(0x4 << 21)
 #define CTRL2_SET_OUTSTANDING_REQS_MASK	(0x7 << 21)
+#define CTRL2_ODD_LINE_PATTERN(x)	(((x) & 0x7) << 12)
+#define CTRL2_EVEN_LINE_PATTERN(x)	(((x) & 0x7) << 16)
+#define CTRL2_LINE_PATTERN_MASK		(CTRL2_ODD_LINE_PATTERN(0x7) | CTRL2_EVEN_LINE_PATTERN(0x7))
+#define CTRL2_LINE_PATTERN_RGB		0x0
+#define CTRL2_LINE_PATTERN_BGR		0x5
 
 #define TRANSFER_COUNT_SET_VCOUNT(x)	(((x) & 0xffff) << 16)
 #define TRANSFER_COUNT_GET_VCOUNT(x)	(((x) >> 16) & 0xffff)
