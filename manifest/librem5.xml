<?xml version="1.0" encoding="UTF-8"?>
<!--
  Librem 5 Android 17 port: GloDroid components layered on AOSP android-17.0.0_r1.
  GloDroid's own manifest targets AOSP 15 r13. Graphics components are moved to
  current upstream so they match Android 17; GloDroid's config/aospext stay at
  their last commits; Android 17 fixes live in this repo's patches/ (scripts/apply-patches.sh).
  Skipped for the first boot: GloDroid u-boot/ATF/kernel (we use Purism u-boot and
  our own kernel), camera, codecs, modem, bundled APKs.
-->
<manifest>
  <!-- This repo (device tree, patches, scripts). scripts/setup.sh fills in where it is hosted. -->
  <remote name="librem5" fetch="@LIBREM5_FETCH@" />
  <project path="device/purism" remote="librem5" name="@LIBREM5_NAME@" revision="@LIBREM5_REV@" />

  <remote name="glodroid" fetch="https://github.com/glodroid/" />
  <remote name="fdo"      fetch="https://gitlab.freedesktop.org/" />
  <remote name="libcamera" fetch="https://git.libcamera.org/" />
  <remote name="ffmpeg"    fetch="https://github.com/FFmpeg/" />
  <remote name="rpi-vanilla" fetch="https://github.com/raspberry-vanilla/" />

  <!-- GloDroid shared configuration (base dir + configuration subdir; same repo, two revisions) -->
  <project path="glodroid"               remote="glodroid" name="glodroid_configuration.git" revision="refs/tags/basedir-v0.9.0" />
  <project path="glodroid/configuration" remote="glodroid" name="glodroid_configuration.git" revision="5b190a05f1e56bff60a1f6630a23a3a745c78392" />

  <!-- Builds meson projects (mesa, drm_hwcomposer, minigbm) inside the AOSP build -->
  <project path="glodroid/vendor/aospext" remote="glodroid" name="aospext.git" revision="8c3075ffb6005b1c317e69d4da4071dc2403e0f9" />

  <!-- Graphics -->
  <project path="glodroid/vendor/mesa3d"         remote="fdo"  name="mesa/mesa.git"                     revision="refs/tags/mesa-26.3.0-rc3" clone-depth="1" />
  <project path="glodroid/vendor/drm_hwcomposer" remote="fdo"  name="drm-hwcomposer/drm-hwcomposer.git" revision="4cd81af6434843848a30a687ec8de46d6fd9d2ea" />
  <project path="glodroid/vendor/minigbm"        remote="aosp" name="platform/external/minigbm"         revision="93e16b90294c4634d43c4987f194204ac3b80ac8" />

  <!-- Cameras: libcamera (simple pipeline + software ISP for the i.MX8MQ CSI), built by aospext -->
  <project path="glodroid/vendor/libcamera" remote="libcamera" name="libcamera/libcamera.git" revision="refs/tags/v0.8.0" clone-depth="1" />

  <!-- Hardware video decoding (Hantro G1/G2, V4L2 stateless): FFmpeg master plus the V4L2 Request
       API hwaccels (patches/glodroid/vendor/ffmpeg, from Jonas Karlman's v4l2request-v3 merge
       request) and the FFmpeg Codec2 service (Raspberry Vanilla's AIDL version), both built by aospext -->
  <project path="glodroid/vendor/ffmpeg"        remote="ffmpeg"      name="FFmpeg.git"                     revision="86eb07154d0255a5e96c822d8dc7805ade600f0b" />
  <project path="glodroid/vendor/ffmpeg_codec2" remote="rpi-vanilla" name="android_external_ffmpeg_codec2" revision="1cb7fcee97f3cedd46857f3cd8354777bed307b2" />
</manifest>
