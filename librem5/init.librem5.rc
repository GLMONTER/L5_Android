# Librem 5 device init
on early-init
    # Kernel modules (vendor_dlkm); brcmfmac needs brcmfmac_wcc loaded explicitly
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor_dlkm/lib/modules \
        --all=/vendor_dlkm/lib/modules/modules.load

on boot
    # Bluetooth after Wi-Fi (see modules.blocklist), through the kill switch recovery below: its
    # SDIO host reset power-cycles the combo chip, which a watchdog reset does not, leaving the
    # Bluetooth part unresponsive (HCI RESET timeouts) until the next power-up. Wait for Wi-Fi
    # first, so that the reset does not interrupt brcmfmac's first firmware download.
    wait /sys/class/net/wlan0 15
    setprop vendor.librem5.wlan_hks unblocked

    # Haptics: pwm-vibrator is exposed as a force-feedback input device
    chown system system /sys/class/leds/vibrator/brightness

# Wi-Fi/Bluetooth kill switch (vendor.librem5.wlan_hks from librem5-hks-monitor). The switch cuts
# the power of the BCM43752 combo chip. Wi-Fi comes back by itself; Bluetooth needs the chip's
# boot-time power sequence and its UART driver loaded again, as at boot: reset the SDIO host
# (mmc1, 30b50000.mmc, never the eMMC), wait for Wi-Fi, then reload hci_uart.
on property:vendor.librem5.wlan_hks=blocked
    stop vendor.bluetooth-default

on property:vendor.librem5.wlan_hks=unblocked
    stop vendor.bluetooth-default
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -r -d /vendor_dlkm/lib/modules hci_uart btbcm
    write /sys/bus/platform/drivers/sdhci-esdhc-imx/unbind 30b50000.mmc
    write /sys/bus/platform/drivers/sdhci-esdhc-imx/bind 30b50000.mmc
    wait /sys/class/net/wlan0 15
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor_dlkm/lib/modules \
        bluetooth btbcm hci_uart
    start vendor.bluetooth-default
    setprop vendor.librem5.wlan_hks on

# Watchdog (imx2-wdt): a hung phone resets itself, and the kernel log of the hang survives in
# pstore (/sys/fs/pstore/console-ramoops-0 after the reboot). The watchdog pauses in suspend.
service watchdogd /system/bin/watchdogd 10 20
    class core
    oneshot
    seclabel u:r:watchdogd:s0

# Suspend debugging, while the occasional hang after resume is investigated: log every device's
# suspend/resume callback at a console log level that reaches pstore. Off with
# `setprop persist.vendor.librem5.pm_debug 0` (it slows each suspend by a few seconds).
on property:persist.vendor.librem5.pm_debug=1 && property:sys.boot_completed=1
    write /sys/power/pm_print_times 1
    write /sys/power/pm_debug_messages 1
    write /proc/sys/kernel/printk "8 4 1 7"

on property:persist.vendor.librem5.pm_debug=0
    write /sys/power/pm_print_times 0
    write /sys/power/pm_debug_messages 0
    write /proc/sys/kernel/printk "3 4 1 7"
