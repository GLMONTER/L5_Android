<?xml version="1.0" encoding="UTF-8"?>
<!-- Librem 5 (WM8962, ALSA card 0) routing for the AIDL primary module (PrimaryRoute).
     Generated from Purism's ALSA UCM profile (librem5-base, before 78pureos1):
     top level = BootSequence + HiFi verb; paths = UCM devices Speaker, Handset1 (earpiece),
     Headphones, Mic (built-in), Headset (headset mic). Coefficient blobs (DRC/3D) omitted. -->
<mixer>
    <!-- BootSequence -->
    <ctl name="Digital Playback Volume" value="96 96" />
    <ctl name="Digital Capture Volume" value="96 96" />
    <ctl name="Speaker Volume" value="121 121" />
    <ctl name="Speaker Boost Volume" value="2" />
    <ctl name="Headphone Volume" value="121 121" />
    <ctl name="Headphone Aux Volume" value="1 1" />
    <ctl name="Capture Volume" value="31 31" />
    <ctl name="MIXINL PGA Volume" value="0" />
    <ctl name="SPKOUTL Mixer DACL Volume" value="1" />
    <ctl name="SPKOUTL Mixer DACR Volume" value="1" />
    <ctl name="SPKOUTR Mixer DACL Volume" value="1" />
    <ctl name="SPKOUTR Mixer DACR Volume" value="1" />
    <ctl name="Speaker ZC Switch" value="1" />
    <ctl name="Headphone ZC Switch" value="1" />
    <ctl name="Capture ZC Switch" value="1" />
    <ctl name="Capture HPF Switch" value="1" />
    <ctl name="Capture HPF Mode" value="Hi-fi" />
    <ctl name="DAC High Performance Switch" value="1" />
    <ctl name="ADC High Performance Switch" value="1" />
    <ctl name="HPF1 Switch" value="1" />
    <ctl name="HPF2 Switch" value="1" />
    <ctl name="DRC Switch" value="1" />
    <ctl name="EQ1 Volume" value="13 13" />
    <ctl name="EQ2 Volume" value="11 11" />
    <ctl name="EQ3 Volume" value="9 9" />
    <ctl name="EQ4 Volume" value="10 10" />
    <ctl name="EQ5 Volume" value="13 13" />
    <!-- HiFi verb: everything routed off -->
    <ctl name="Speaker Mixer Switch" value="0" />
    <ctl name="Headphone Mixer Switch" value="0" />
    <ctl name="DAC Monomix Switch" value="0" />
    <ctl name="ADC Monomix Switch" value="0" />
    <ctl name="DAC L/R Swap Switch" value="0" />
    <ctl name="ADC L/R Swap Switch" value="0" />
    <ctl name="INPGAL IN1L Switch" value="0" />
    <ctl name="INPGAL IN2L Switch" value="0" />
    <ctl name="INPGAL IN3L Switch" value="0" />
    <ctl name="INPGAL IN4L Switch" value="0" />
    <ctl name="INPGAR IN1R Switch" value="0" />
    <ctl name="INPGAR IN2R Switch" value="0" />
    <ctl name="INPGAR IN3R Switch" value="0" />
    <ctl name="INPGAR IN4R Switch" value="0" />
    <ctl name="MIXINL IN2L Switch" value="0" />
    <ctl name="MIXINL IN3L Switch" value="0" />
    <ctl name="MIXINL PGA Switch" value="0" />
    <ctl name="MIXINR IN2R Switch" value="0" />
    <ctl name="MIXINR IN3R Switch" value="0" />
    <ctl name="MIXINR PGA Switch" value="0" />
    <ctl name="Input Mixer Switch" value="0" />
    <ctl name="SPKOUTL PGA" value="Mixer" />
    <ctl name="SPKOUTR PGA" value="Mixer" />
    <ctl name="HPOUTL PGA" value="Mixer" />
    <ctl name="HPOUTR PGA" value="Mixer" />
    <ctl name="HD Bass Switch" value="0" />
    <ctl name="EQ Switch" value="0" />

    <path name="speaker">
        <ctl name="SPKOUTL Mixer DACL Switch" value="1" />
        <ctl name="SPKOUTL Mixer DACR Switch" value="1" />
        <ctl name="SPKOUTR Mixer DACL Switch" value="1" />
        <ctl name="SPKOUTR Mixer DACR Switch" value="1" />
        <ctl name="HD Bass Switch" value="1" />
        <ctl name="EQ Switch" value="1" />
        <ctl name="Speaker Mixer Switch" value="1" />
    </path>

    <path name="earpiece">
        <ctl name="DAC Monomix Switch" value="1" />
        <ctl name="SPKOUTR PGA" value="DAC" />
    </path>

    <path name="headphones">
        <ctl name="HPOUTL PGA" value="DAC" />
        <ctl name="HPOUTR PGA" value="DAC" />
    </path>

    <path name="builtin-mic">
        <ctl name="ADC L/R Swap Switch" value="1" />
        <ctl name="Input Mode" value="Digital" />
    </path>

    <path name="headset-mic">
        <ctl name="MIXINR IN3R Switch" value="1" />
        <ctl name="MIXINL IN3L Switch" value="1" />
        <ctl name="Input Mode" value="Analog" />
        <ctl name="Input Mixer Switch" id="0" value="0" />
        <ctl name="Input Mixer Switch" id="1" value="1" />
    </path>
</mixer>
