# --- HALs installed by this device tree ---
/vendor/bin/hw/android\.hardware\.sensors-service\.librem5   u:object_r:hal_sensors_default_exec:s0

# Stable-C mapper (minigbm, "_gd" suffix): loaded in-process by every graphics client
/vendor/lib(64)?/mapper\.minigbm_gd\.so                     u:object_r:same_process_hal_file:s0

# --- Device nodes ---
# card0 etnaviv, card1 mxsfb (panel) are labeled by GloDroid; card2 is the HDMI DCSS controller
/dev/dri/card2                                              u:object_r:gpu_device:s0
/dev/rfkill                                                 u:object_r:rfkill_device:s0

# eMMC user-area partitions (GPT names from scripts/make-images.sh); ueventd labels the nodes
# via these by-name aliases
/dev/block/by-name/bootfs                                   u:object_r:boot_block_device:s0
/dev/block/by-name/misc                                     u:object_r:misc_block_device:s0
/dev/block/by-name/frp                                      u:object_r:frp_block_device:s0
/dev/block/by-name/metadata                                 u:object_r:metadata_block_device:s0
/dev/block/by-name/super                                    u:object_r:super_block_device:s0
/dev/block/by-name/userdata                                 u:object_r:userdata_block_device:s0
/vendor/bin/hw/android\.hardware\.power-service\.librem5    u:object_r:hal_power_default_exec:s0
/vendor/bin/hw/android\.hardware\.lights-service\.librem5   u:object_r:hal_light_default_exec:s0

# Vendor libraries that system processes (SurfaceFlinger, apps, codecs) load in-process through
# Mesa's EGL driver and the minigbm mapper (sphal namespace) and that neither AOSP nor GloDroid
# label (AOSP covers libbase/libcutils/libutils/libz/libhidlbase/libhardware/libgralloctypes,
# graphics.common@1.x, mapper@*, allocator-V2; GloDroid covers libgbm_mesa/libminigbm_gralloc_gd
# and dri/libgallium_dri). Mesa 26 installs libgallium_dri.so directly in lib64/.
/vendor/lib(64)?/libgallium_dri\.so                                          u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libui\.so                                                   u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libc\+\+\.so                                                u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libaconfig_storage_read_api_cc\.so                          u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.graphics\.common-V7-ndk\.so              u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.graphics\.allocator@[234]\.0\.so         u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libgbm_mesa_wrapper\.so                                       u:object_r:same_process_hal_file:s0
# Mesa's GBM backend, dlopen()ed by libgbm_mesa inside every process that CPU-maps a buffer
# (system_server's task snapshots crash on a NULL backend if it cannot load)
/vendor/lib(64)?/gbm(/.*)?                                                    u:object_r:same_process_hal_file:s0
# BM818 modem: radio HAL and its USB serial ports
/vendor/bin/hw/android\.hardware\.radio-service\.librem5                      u:object_r:hal_radio_default_exec:s0
/dev/ttyUSB[0-9]+                                                             u:object_r:radio_device:s0
# Cameras: AIDL camera provider (libcamera HAL). libcamera opens the media controller, the
# sensor/CSI/VCM/flash subdevs and the CSI capture nodes. GloDroid labels a few fixed node
# numbers camera_device (fine: hal_camera may use both); everything else is video_device.
/vendor/bin/hw/android\.hardware\.camera\.provider-service\.librem5           u:object_r:hal_camera_default_exec:s0
/dev/media[0-9]+                                                              u:object_r:video_device:s0
/dev/v4l-subdev[0-9]+                                                         u:object_r:video_device:s0
/vendor/bin/librem5-hks-monitor                                             u:object_r:hks_monitor_exec:s0
