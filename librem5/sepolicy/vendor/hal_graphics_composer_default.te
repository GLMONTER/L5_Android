# Panel brightness through /sys/class/backlight/backlight-dsi
allow hal_graphics_composer_default sysfs_backlight:dir r_dir_perms;
allow hal_graphics_composer_default sysfs_backlight:lnk_file read;
allow hal_graphics_composer_default sysfs_backlight:file rw_file_perms;
get_prop(hal_graphics_composer_default, vendor_hwc_prop)
