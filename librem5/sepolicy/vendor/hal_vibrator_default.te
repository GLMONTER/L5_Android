# pwm-vibrator is a force-feedback input device: find it via sysfs, drive it with EV_FF ioctls
allow hal_vibrator_default sysfs_vibrator:dir r_dir_perms;
allow hal_vibrator_default sysfs_vibrator:file r_file_perms;
allow hal_vibrator_default input_device:dir r_dir_perms;
allow hal_vibrator_default input_device:chr_file rw_file_perms;
allowxperm hal_vibrator_default input_device:chr_file ioctl { 0x4501-0x45ff };
