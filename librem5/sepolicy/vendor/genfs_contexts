# IIO sensors on i2c-1: VCNL4040 (0x60), LSM9DS1 magnetometer (0x1e), LSM9DS1 accel+gyro (0x6a)
genfscon sysfs /bus/iio                                                                    u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a30000.i2c/i2c-1/1-0060/iio:device  u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a30000.i2c/i2c-1/1-001e/iio:device  u:object_r:sysfs_iio:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a30000.i2c/i2c-1/1-006a/iio:device  u:object_r:sysfs_iio:s0

# Battery (MAX17055 fuel gauge), charger (BQ25890), USB-C source (TPS6598x)
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a50000.i2c/i2c-3/3-0036/power_supply u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a50000.i2c/i2c-3/3-006a/power_supply u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a20000.i2c/i2c-0/0-003f/power_supply u:object_r:sysfs_batteryinfo:s0

# GPU / display controllers (Mesa probes every DRM device's sysfs node)
genfscon sysfs /devices/platform/etnaviv                                                   u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/soc@0/30000000.bus/30320000.lcd-controller                u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/soc@0/32c00000.bus/32e00000.display-controller            u:object_r:sysfs_gpu:s0

# Backlight, vibrator, USB extcon
genfscon sysfs /class/backlight                                                            u:object_r:sysfs_backlight:s0
genfscon sysfs /devices/platform/backlight-dsi/backlight                                   u:object_r:sysfs_backlight:s0
genfscon sysfs /devices/platform/vibrator                                                  u:object_r:sysfs_vibrator:s0
genfscon sysfs /devices/platform/soc@0/381f0040.usb-phy/extcon                             u:object_r:sysfs_extcon:s0

# DRAM controller devfreq (power HAL boosts min_freq)
genfscon sysfs /class/devfreq                                                              u:object_r:sysfs_devfreq_dir:s0
genfscon sysfs /devices/platform/soc@0/3d400000.memory-controller/devfreq                  u:object_r:sysfs_ddr_devfreq:s0

# RGB status LED (lights HAL) and the camera flash LED
genfscon sysfs /devices/platform/led-controller/leds                                       u:object_r:sysfs_leds:s0

# Wakeup sources (system_suspend reads their stats); prefix match covers wakeupN numbering
genfscon sysfs /devices/platform/soc@0/38200000.usb/wakeup                                        u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a20000.i2c/i2c-0/0-0068/wakeup              u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a20000.i2c/i2c-0/0-003f/wakeup              u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a20000.i2c/i2c-0/0-003f/power_supply/tps6598x-source-psy-0-003f/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a50000.i2c/i2c-3/3-0036/power_supply/max170xx_battery/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a50000.i2c/i2c-3/3-006a/power_supply/bq25890-charger-0/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30000000.bus/30370000.snvs/30370000.snvs:snvs-powerkey/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30000000.bus/30370000.snvs/30370000.snvs:snvs-rtc-lp/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/30000000.bus/30370000.snvs/30370000.snvs:snvs-rtc-lp/rtc/rtc1/alarmtimer.0.auto/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/rfkill-hks/wakeup                                                u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/gpio-keys/wakeup                                                 u:object_r:sysfs_wakeup:s0

# eMMC block device (storaged stats, init queue tuning) and the TPS6598x USB-C extcon
genfscon sysfs /devices/platform/soc@0/30800000.bus/30b40000.mmc/mmc_host/mmc0/mmc0:0001/block    u:object_r:sysfs_devices_block:s0
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a20000.i2c/i2c-0/0-003f/extcon              u:object_r:sysfs_extcon:s0
# Console log level (GloDroid init.common.rc writes it from vendor_init) and the USB-C PHY extcon
genfscon proc /sys/kernel/printk                                                  u:object_r:proc_printk:s0
genfscon sysfs /devices/platform/soc@0/382f0040.usb-phy/extcon                             u:object_r:sysfs_extcon:s0

# LM3560 flash LED (i2c-1 0x53): camera torch, written by the camera HAL
genfscon sysfs /devices/platform/soc@0/30800000.bus/30a30000.i2c/i2c-1/1-0053/leds          u:object_r:sysfs_leds:s0

# i.MX SDHC driver bind/unbind: init resets the Wi-Fi/BT SDIO host after the kill switch
genfscon sysfs /bus/platform/drivers/sdhci-esdhc-imx                                        u:object_r:sysfs_sdio_host:s0
# USB device controller attributes (the gadget HAL reads current_speed; /sys/class/udc is sysfs_udc)
genfscon sysfs /devices/platform/soc@0/38100000.usb/udc                         u:object_r:sysfs_udc:s0
